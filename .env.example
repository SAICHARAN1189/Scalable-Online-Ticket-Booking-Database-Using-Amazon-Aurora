# .env.example — Copy to .env and fill in real values
# NEVER commit .env to version control

# Aurora Writer endpoint (INSERT/UPDATE/DELETE)
AURORA_WRITER_HOST=your-cluster.cluster-xxxx.ap-south-1.rds.amazonaws.com
# Aurora Reader endpoint (SELECT queries)
AURORA_READER_HOST=your-cluster.cluster-ro-xxxx.ap-south-1.rds.amazonaws.com

AURORA_PORT=5432
AURORA_DB_NAME=postgres
AURORA_USERNAME=postgres
AURORA_PASSWORD=
USE_IAM_AUTH=true
AWS_REGION=ap-south-1

# Flask
FLASK_SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING
FLASK_ENV=development
FLASK_DEBUG=0

# Use local SQLite mock for offline development/testing (true/false)
USE_LOCAL_DB=true
